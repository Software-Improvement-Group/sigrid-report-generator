{
  "permissions": {
    "allow": [
      "Bash(ruff format:*)",
      "Bash(ruff check:*)",
      "WebFetch(domain:docs.sigrid-says.com)",
      "mcp__plugin_sigrid_sigrid__code_quality_guardrails"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check --fix --unfixable=F401 . && ruff format . && lint-imports"
          }
        ]
      }
    ]
  }
}